# ============================================================
# 环境变量模板（本文件入库，只含键名与说明，不含任何真实凭据）
#
# 用法：
#   cp .env.example .env
#   然后把 .env 里的占位值换成真实值
#
# ⚠️ .env 已在 .gitignore 中忽略，不会被提交
# ============================================================

# ---------- MySQL 数据库 ----------
GOLF_DB_HOST=<host>
GOLF_DB_PORT=3306
GOLF_DB_USER=<user>
GOLF_DB_PASSWORD=<password>
GOLF_DB_NAME=golf
GOLF_DB_MAX_CONN=5

# ---------- 微信小程序 ----------
GOLF_WX_APPID=<appid>
GOLF_WX_SECRET=<appsecret>

# ---------- 可选：运行时目录与对外地址 ----------
# GOLF_DATA_DIR=E:/project/golf/backend/data/tasks
# GOLF_PUBLIC_BASE_URL=http://127.0.0.1:8000
