/* 全局样式变量与基础排版 */

page {
  --bg: #0e1116;
  --bg-card: #171c24;
  --bg-card-2: #1f2630;
  --line: #2a323e;
  --text: #f2f5f8;
  --text-sub: #9aa6b5;
  --text-dim: #6b7686;
  --brand: #1fbf75;
  --warn: #ff8c1a;
  --danger: #f5483b;
  --accent: #48a7f5;

  background-color: #0e1116;
  color: #f2f5f8;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  line-height: 1.6;
}

view,
text,
scroll-view,
button,
image {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 60rpx;
}

.card {
  background: #171c24;
  border: 1rpx solid #2a323e;
  border-radius: 20rpx;
  padding: 28rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #9aa6b5;
}

.muted {
  color: #9aa6b5;
}

.btn {
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #1fbf75, #16a862);
  color: #ffffff;
}

.btn-primary[disabled] {
  background: #263040;
  color: #5e6a79;
}

.btn-ghost {
  background: #1f2630;
  color: #f2f5f8;
  border: 1rpx solid #2a323e;
}

.tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.tag-normal {
  background: rgba(31, 191, 117, 0.16);
  color: #1fbf75;
}

.tag-warn {
  background: rgba(255, 140, 26, 0.16);
  color: #ff8c1a;
}

.tag-danger {
  background: rgba(245, 72, 59, 0.16);
  color: #f5483b;
}
