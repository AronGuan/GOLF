<!--pages/result/result.wxml 分析结果页：8 阶段缩略图 + 大图 + 指标卡 + 风险区 + 全程指标-->
<view class="page">

  <block wx:if="{{loaded}}">

    <!-- 顶部机位标签（v2）+ 提示 -->
    <view class="topbar">
      <view class="topbar__view">{{viewLabel}} · {{analyzedDate}}</view>
      <view class="topbar__sub">挥杆姿态报告</view>
    </view>

    <!-- 顶部提示（低帧率 / 估算阶段等） -->
    <view class="warn-bar" wx:if="{{warnings.length > 0}}">
      <view class="warn-item" wx:for="{{warnings}}" wx:key="*this">· {{item}}</view>
    </view>

    <!-- 阶段缩略图横向滚动 -->
    <scroll-view
      class="thumbs"
      scroll-x="true"
      enable-flex="true"
      scroll-with-animation="true"
      scroll-into-view="{{scrollInto}}">
      <view
        class="thumb {{index === current ? 'thumb--on' : ''}} {{item.adjActive ? 'thumb--adj' : ''}}"
        wx:for="{{phases}}"
        wx:key="key"
        id="thumb-{{index}}"
        data-index="{{index}}"
        bindtap="onSelect">
        <view class="thumb__imgbox" style="width:160rpx;height:{{160 / videoAspect}}rpx">
          <image class="thumb__img" src="{{item.image_url}}" mode="aspectFit" lazy-load="true" />
          <view class="thumb__no">{{item.index}}</view>
          <view class="thumb__est" wx:if="{{item.estimated}}">估</view>
          <view class="thumb__adjtag" wx:if="{{item.adjActive}}">手动</view>
        </view>
        <view class="thumb__name">{{item.name_cn}}</view>
        <!-- 手动帧微调（v3）：◀ ▶ + 帧号 + 手动标识 -->
        <view class="thumb__adj">
          <view
            class="thumb__btn {{item.adjCur <= item.adjMin || item.adjLoading ? 'thumb__btn--off' : ''}}"
            data-delta="-1"
            catchtap="onFrameStep">◀</view>
          <view class="thumb__frame {{item.adjActive ? 'thumb__frame--adj' : ''}}">{{item.adjCur}}帧</view>
          <view
            class="thumb__btn {{item.adjCur >= item.adjMax || item.adjLoading ? 'thumb__btn--off' : ''}}"
            data-delta="1"
            catchtap="onFrameStep">▶</view>
        </view>
      </view>
    </scroll-view>

    <!-- 当前阶段大图 -->
    <view class="hero">
      <view class="hero__head">
        <view class="hero__title">
          <text class="hero__no">{{cur.index}}</text>
          <text class="hero__cn">{{cur.name_cn}}</text>
          <text class="hero__en">{{cur.name_en}}</text>
        </view>
        <view class="hero__time">{{cur.timeText}}</view>
      </view>

      <view class="hero__imgbox" bindtap="onPreview">
        <image class="hero__img" src="{{cur.image_url}}" mode="aspectFit" show-menu-by-longpress="true" />
        <view class="hero__tag" wx:if="{{cur.estimated}}">该帧为估算位置</view>
        <view class="hero__tag hero__tag--adj" wx:if="{{cur.adjActive}}">手动调整 · 第{{cur.adjCur}}帧</view>
        <view class="hero__zoom">点击查看大图</view>
      </view>

      <view class="hero__ops">
        <view class="op op--ghost" bindtap="onPrev">上一阶段</view>
        <view class="op op--ghost" bindtap="onNext">下一阶段</view>
        <view class="op op--ghost" bindtap="onSaveImage">保存本帧</view>
      </view>

      <!-- 整页截图（v3）：把当前看到的内容合成为一张图保存相册 -->
      <view
        class="op op--primary op--savepage {{snapSaving ? 'op--loading' : ''}}"
        bindtap="onSavePage">{{snapSaving ? '保存中...' : '保存当前页到相册'}}</view>
    </view>

    <!-- 当前阶段指标（v2：空状态优雅处理 + description 术语解释行） -->
    <view class="section">
      <view class="section__title">
        <text>阶段指标</text>
        <text class="section__sub" wx:if="{{cur.metrics.length > 0}}">共 {{cur.metrics.length}} 项</text>
      </view>

      <!-- 手动微调时指标重算提示（v3 增量：loading / 失败降级） -->
      <view class="metric-note" wx:if="{{cur.metricLoading}}">指标计算中...</view>
      <view class="metric-note metric-note--err" wx:elif="{{cur.metricError}}">{{cur.metricError}}</view>

      <!-- 0 项指标：占位卡（用户决策 2：侧面机位部分阶段允许 0~1 项） -->
      <view class="empty-metric" wx:if="{{cur.emptyMetrics}}">
        <view class="empty-metric__icon">📊</view>
        <view class="empty-metric__text">该机位在本阶段暂无可测指标</view>
        <view class="empty-metric__sub">换正面机位可查看更多指标</view>
      </view>

      <block wx:else>
        <view class="mcard" wx:for="{{cur.metrics}}" wx:key="key">
          <view class="mcard__row">
            <view class="mcard__name">{{item.name}}</view>
            <view class="mcard__val">
              <text class="mcard__num status--{{item.status}}">{{item.valueText}}</text>
              <text class="mcard__unit">{{item.unit}}</text>
            </view>
          </view>

          <view class="bar">
            <view class="bar__track"></view>
            <view class="bar__ref" style="left:{{item.refFrom}}%;width:{{item.refWidth}}%;"></view>
            <view class="bar__mark status-bg--{{item.status}}" style="left:{{item.markPct}}%;"></view>
          </view>

          <view class="mcard__foot">
            <view class="chip chip--{{item.status}}">{{item.statusText}}</view>
            <view class="mcard__ref">参考 {{item.refText}}{{item.unit}}</view>
          </view>

          <!-- v2：术语解释行 -->
          <view class="mcard__desc" wx:if="{{item.description}}">{{item.description}}</view>
        </view>
      </block>
    </view>

    <!-- 🆕 区域4：本阶段风险与改进建议（v2） -->
    <view class="section">
      <view class="section__title">
        <text>风险与改进建议</text>
        <text class="section__sub" wx:if="{{cur.risks.length > 0}}">共 {{cur.risks.length}} 条</text>
      </view>

      <!-- 无风险空状态 -->
      <view class="risk-ok" wx:if="{{cur.risks.length === 0}}">
        <view class="risk-ok__icon">✅</view>
        <view class="risk-ok__text">本阶段动作良好，无高风险项</view>
      </view>

      <!-- 风险卡片列表 -->
      <view class="rcard rcard--{{item.level}}" wx:for="{{cur.risks}}" wx:key="rule_id">
        <view class="rcard__head">
          <view class="rcard__dot"></view>
          <view class="rcard__name">{{item.risk_name}}</view>
          <view class="rcard__level">{{item.levelText}}</view>
        </view>
        <view class="rcard__reason">{{item.trigger_description}}</view>
        <view class="rcard__suggest" wx:if="{{item.suggestions.length > 0}}">
          <view class="rcard__suggest-title">改进建议：</view>
          <view class="rcard__suggest-item" wx:for="{{item.suggestions}}" wx:for-item="sg" wx:key="*this">· {{sg}}</view>
        </view>
        <view class="rcard__manual" wx:if="{{item.manual_excerpt}}" data-index="{{index}}" bindtap="onOpenManual">📖 查看手册原文</view>
      </view>
    </view>

    <!-- 全程指标 -->
    <view class="section">
      <view class="section__title"><text>全程指标</text></view>
      <view class="gbar">
        <view class="gitem" wx:for="{{globals}}" wx:key="key">
          <view class="gitem__num status--{{item.status}}">{{item.valueText}}<text class="gitem__unit">{{item.unit}}</text></view>
          <view class="gitem__name">{{item.name}}</view>
          <view class="gitem__ref">{{item.statusText}} · 参考 {{item.refText}}</view>
        </view>
      </view>
    </view>

    <!-- 视频信息 -->
    <view class="section">
      <view class="section__title"><text>视频信息</text></view>
      <view class="meta">
        <view class="meta__i"><text class="meta__k">机位</text><text class="meta__v">{{viewLabel}}</text></view>
        <view class="meta__i"><text class="meta__k">分辨率</text><text class="meta__v">{{meta.width}}×{{meta.height}}</text></view>
        <view class="meta__i"><text class="meta__k">帧率</text><text class="meta__v">{{meta.fpsText}} fps</text></view>
        <view class="meta__i"><text class="meta__k">时长</text><text class="meta__v">{{meta.durationText}} s</text></view>
      </view>
    </view>

    <view class="disclaimer">{{disclaimer}}</view>

    <!-- v2：[查看完整报告] 占位按钮（P1 预留） -->
    <view class="report-btn" bindtap="onFullReport">查看完整报告（即将上线）</view>

    <view class="footer">
      <view class="btn btn--primary" bindtap="onRetake">再分析一次</view>
    </view>

    <!-- 整页截图离屏 canvas（type=2d；离屏绘制后导出保存相册，v3） -->
    <canvas
      type="2d"
      id="snapshotCanvas"
      class="snapshot-canvas"
      style="width:750px;height:{{snapH}}px;"
    ></canvas>

  </block>

  <view class="empty" wx:else>
    <view class="empty__icon">·</view>
    <view class="empty__text">结果已失效，请重新上传视频</view>
    <view class="btn btn--primary" bindtap="onRetake">去上传</view>
  </view>

  <!-- 🆕 手册原文半屏弹窗（v2） -->
  <view class="mask" wx:if="{{manual}}" bindtap="onCloseManual">
    <view class="manual" catchtap="noop">
      <view class="manual__head">
        <text class="manual__title">{{manual.risk_name}}</text>
        <text class="manual__close" bindtap="onCloseManual">✕</text>
      </view>
      <view class="manual__page" wx:if="{{manual.manual_page}}">手册页码：{{manual.manual_page}}</view>
      <scroll-view class="manual__body" scroll-y="true">
        <text class="manual__text">{{manual.manual_excerpt}}</text>
      </scroll-view>
      <view class="manual__foot" bindtap="onCloseManual">关闭</view>
    </view>
  </view>

</view>
