/* pages/result/result.wxss */
.page {
  min-height: 100vh;
  padding: 0 0 40rpx;
  box-sizing: border-box;
  background: var(--bg, #0f1720);
  color: var(--text, #eaf0f6);
}

/* ---------------- 警告条 ---------------- */
.warn-bar {
  margin: 16rpx 24rpx 0;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(240, 173, 78, 0.12);
  border: 1rpx solid rgba(240, 173, 78, 0.35);
}
.warn-item {
  font-size: 22rpx;
  line-height: 34rpx;
  color: #f0ad4e;
}

/* ---------------- 缩略图 ---------------- */
.thumbs {
  width: 100%;
  white-space: nowrap;
  padding: 20rpx 0 8rpx;
  box-sizing: border-box;
}
.thumb {
  display: inline-block;
  width: 132rpx;
  margin-left: 20rpx;
  vertical-align: top;
}
.thumb:last-child {
  margin-right: 20rpx;
}
.thumb__imgbox {
  position: relative;
  width: 132rpx;
  height: 176rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #1b2530;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
.thumb--on .thumb__imgbox {
  border-color: var(--accent, #3ddc97);
  box-shadow: 0 0 16rpx rgba(61, 220, 151, 0.45);
}
.thumb__img {
  width: 100%;
  height: 100%;
}
.thumb__no {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 15rpx;
  font-size: 20rpx;
  color: #0f1720;
  background: rgba(255, 255, 255, 0.85);
}
.thumb--on .thumb__no {
  background: var(--accent, #3ddc97);
}
.thumb__est {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  padding: 0 8rpx;
  height: 28rpx;
  line-height: 28rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  color: #0f1720;
  background: #f0ad4e;
}
.thumb__name {
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-dim, #6b7686);
}
.thumb--on .thumb__name {
  color: var(--accent, #3ddc97);
}

/* ---------------- 大图区 ---------------- */
.hero {
  margin: 12rpx 24rpx 0;
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--card, #18222c);
}
.hero__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hero__title {
  display: flex;
  align-items: baseline;
}
.hero__no {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #0f1720;
  background: var(--accent, #3ddc97);
}
.hero__cn {
  margin-left: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
}
.hero__en {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: var(--text-dim, #6b7686);
}
.hero__time {
  font-size: 22rpx;
  color: var(--text-dim, #6b7686);
}
.hero__imgbox {
  position: relative;
  margin-top: 16rpx;
  width: 100%;
  height: 720rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #0b1218;
}
.hero__img {
  width: 100%;
  height: 100%;
}
.hero__tag {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #0f1720;
  background: rgba(240, 173, 78, 0.9);
}
.hero__zoom {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.75);
  background: rgba(0, 0, 0, 0.45);
}
.hero__ops {
  display: flex;
  margin-top: 16rpx;
}
.op {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 24rpx;
  border-radius: 10rpx;
  margin-right: 12rpx;
}
.op:last-child {
  margin-right: 0;
}
.op--ghost {
  color: var(--text, #eaf0f6);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
}

/* ---------------- 区块 ---------------- */
.section {
  margin: 24rpx 24rpx 0;
}
.section__title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.section__sub {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-dim, #6b7686);
}

/* ---------------- 指标卡 ---------------- */
.mcard {
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-radius: 14rpx;
  background: var(--card, #18222c);
}
.mcard__row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.mcard__name {
  font-size: 26rpx;
}
.mcard__val {
  display: flex;
  align-items: baseline;
}
.mcard__num {
  font-size: 40rpx;
  font-weight: 700;
  font-family: "DIN Alternate", "Helvetica Neue", sans-serif;
}
.mcard__unit {
  margin-left: 4rpx;
  font-size: 22rpx;
  color: var(--text-dim, #6b7686);
}

.bar {
  position: relative;
  height: 24rpx;
  margin: 18rpx 0 12rpx;
}
.bar__track {
  position: absolute;
  left: 0;
  right: 0;
  top: 9rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(255, 255, 255, 0.1);
}
.bar__ref {
  position: absolute;
  top: 9rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(61, 220, 151, 0.45);
}
.bar__mark {
  position: absolute;
  top: 0;
  width: 12rpx;
  height: 24rpx;
  margin-left: -6rpx;
  border-radius: 6rpx;
}

.mcard__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mcard__ref {
  font-size: 22rpx;
  color: var(--text-dim, #6b7686);
}
.chip {
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
}
.chip--normal {
  color: #0f1720;
  background: var(--accent, #3ddc97);
}
.chip--low {
  color: #0f1720;
  background: #6cb2f7;
}
.chip--high {
  color: #0f1720;
  background: #f0ad4e;
}

.status--normal {
  color: var(--accent, #3ddc97);
}
.status--low {
  color: #6cb2f7;
}
.status--high {
  color: #f0ad4e;
}
.status-bg--normal {
  background: var(--accent, #3ddc97);
}
.status-bg--low {
  background: #6cb2f7;
}
.status-bg--high {
  background: #f0ad4e;
}

/* ---------------- 全程指标 ---------------- */
.gbar {
  display: flex;
  padding: 20rpx 8rpx;
  border-radius: 14rpx;
  background: var(--card, #18222c);
}
.gitem {
  flex: 1;
  text-align: center;
  padding: 0 8rpx;
}
.gitem__num {
  font-size: 36rpx;
  font-weight: 700;
}
.gitem__unit {
  font-size: 20rpx;
  margin-left: 2rpx;
}
.gitem__name {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text, #eaf0f6);
}
.gitem__ref {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: var(--text-dim, #6b7686);
}

/* ---------------- 视频信息 ---------------- */
.meta {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 20rpx;
  border-radius: 14rpx;
  background: var(--card, #18222c);
}
.meta__i {
  width: 50%;
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
}
.meta__i:nth-child(odd) {
  padding-right: 24rpx;
  box-sizing: border-box;
}
.meta__k {
  font-size: 22rpx;
  color: var(--text-dim, #6b7686);
}
.meta__v {
  font-size: 22rpx;
}

/* ---------------- 底部 ---------------- */
.disclaimer {
  margin: 24rpx 24rpx 0;
  font-size: 20rpx;
  line-height: 32rpx;
  color: var(--text-dim, #6b7686);
}
.footer {
  margin: 24rpx 24rpx 0;
}
.btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
}
.btn--primary {
  color: #0f1720;
  font-weight: 600;
  background: var(--accent, #3ddc97);
}

/* ---------------- 空状态 ---------------- */
.empty {
  padding: 240rpx 60rpx 0;
  text-align: center;
}
.empty__icon {
  font-size: 80rpx;
  color: var(--text-dim, #6b7686);
}
.empty__text {
  margin: 20rpx 0 40rpx;
  font-size: 26rpx;
  color: var(--text-dim, #6b7686);
}
