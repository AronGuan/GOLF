/* pages/result/result.wxss */
.page {
  min-height: 100vh;
  padding: 0 0 40rpx;
  box-sizing: border-box;
  background: var(--bg, #0f1720);
  color: var(--text, #eaf0f6);
}

/* ---------------- 警告条 ---------------- */
.warn-bar {
  margin: 16rpx 24rpx 0;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(240, 173, 78, 0.12);
  border: 1rpx solid rgba(240, 173, 78, 0.35);
}
.warn-item {
  font-size: 22rpx;
  line-height: 34rpx;
  color: #f0ad4e;
}

/* ---------------- 缩略图 ---------------- */
.thumbs {
  width: 100%;
  white-space: nowrap;
  padding: 20rpx 0 8rpx;
  box-sizing: border-box;
}
.thumb {
  display: inline-block;
  width: 160rpx;
  margin-left: 20rpx;
  vertical-align: top;
}
.thumb:last-child {
  margin-right: 20rpx;
}
/* 缩略图容器：高度由 wxml 内联样式按视频宽高比动态计算（方案 A），
   此处固定 height 仅作兜底（videoAspect 缺失/非法时避免容器塌陷） */
.thumb__imgbox {
  position: relative;
  width: 160rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #1b2530;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
.thumb--on .thumb__imgbox {
  border-color: var(--accent, #3ddc97);
  box-shadow: 0 0 16rpx rgba(61, 220, 151, 0.45);
}
.thumb__img {
  width: 100%;
  height: 100%;
}
.thumb__no {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 15rpx;
  font-size: 20rpx;
  color: #0f1720;
  background: rgba(255, 255, 255, 0.85);
}
.thumb--on .thumb__no {
  background: var(--accent, #3ddc97);
}
.thumb__est {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  padding: 0 8rpx;
  height: 28rpx;
  line-height: 28rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  color: #0f1720;
  background: #f0ad4e;
}
.thumb__name {
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-dim, #6b7686);
}
.thumb--on .thumb__name {
  color: var(--accent, #3ddc97);
}

/* ---------------- 手动帧微调（v3） ---------------- */
.thumb--adj .thumb__imgbox {
  border-color: #f0ad4e;
  box-shadow: 0 0 14rpx rgba(240, 173, 78, 0.45);
}
.thumb__adjtag {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  padding: 0 8rpx;
  height: 28rpx;
  line-height: 28rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  color: #0f1720;
  background: #f0ad4e;
}
.thumb__adj {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6rpx;
}
.thumb__btn {
  width: 44rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: var(--text, #eaf0f6);
  background: rgba(255, 255, 255, 0.08);
}
.thumb__btn--off {
  opacity: 0.35;
}
.thumb__frame {
  min-width: 56rpx;
  text-align: center;
  font-size: 18rpx;
  color: var(--text-dim, #6b7686);
}
.thumb__frame--adj {
  color: #f0ad4e;
  font-weight: 600;
}

/* ---------------- 大图区 ---------------- */
.hero {
  margin: 12rpx 24rpx 0;
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--card, #18222c);
}
.hero__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hero__title {
  display: flex;
  align-items: baseline;
}
.hero__no {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #0f1720;
  background: var(--accent, #3ddc97);
}
.hero__cn {
  margin-left: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
}
.hero__en {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: var(--text-dim, #6b7686);
}
.hero__time {
  font-size: 22rpx;
  color: var(--text-dim, #6b7686);
}
.hero__imgbox {
  position: relative;
  margin-top: 16rpx;
  width: 100%;
  height: 720rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #0b1218;
}
.hero__img {
  width: 100%;
  height: 100%;
}
.hero__tag {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #0f1720;
  background: rgba(240, 173, 78, 0.9);
}
.hero__tag--adj {
  left: 16rpx;
  top: auto;
  bottom: 16rpx;
  background: rgba(240, 173, 78, 0.92);
}
.hero__zoom {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.75);
  background: rgba(0, 0, 0, 0.45);
}
.hero__ops {
  display: flex;
  margin-top: 16rpx;
}
.op {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 24rpx;
  border-radius: 10rpx;
  margin-right: 12rpx;
}
.op:last-child {
  margin-right: 0;
}
.op--ghost {
  color: var(--text, #eaf0f6);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
}

/* ---------------- 区块 ---------------- */
.section {
  margin: 24rpx 24rpx 0;
}
.section__title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.section__sub {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-dim, #6b7686);
}

/* ---------------- 指标卡 ---------------- */
.mcard {
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-radius: 14rpx;
  background: var(--card, #18222c);
}
.mcard__row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.mcard__name {
  font-size: 26rpx;
}
.mcard__val {
  display: flex;
  align-items: baseline;
}
.mcard__num {
  font-size: 40rpx;
  font-weight: 700;
  font-family: "DIN Alternate", "Helvetica Neue", sans-serif;
}
.mcard__unit {
  margin-left: 4rpx;
  font-size: 22rpx;
  color: var(--text-dim, #6b7686);
}

.bar {
  position: relative;
  height: 24rpx;
  margin: 18rpx 0 12rpx;
}
.bar__track {
  position: absolute;
  left: 0;
  right: 0;
  top: 9rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(255, 255, 255, 0.1);
}
.bar__ref {
  position: absolute;
  top: 9rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(61, 220, 151, 0.45);
}
.bar__mark {
  position: absolute;
  top: 0;
  width: 12rpx;
  height: 24rpx;
  margin-left: -6rpx;
  border-radius: 6rpx;
}

.mcard__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mcard__ref {
  font-size: 22rpx;
  color: var(--text-dim, #6b7686);
}
.chip {
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
}
.chip--normal {
  color: #0f1720;
  background: var(--accent, #3ddc97);
}
.chip--low {
  color: #0f1720;
  background: #6cb2f7;
}
.chip--high {
  color: #0f1720;
  background: #f0ad4e;
}

.status--normal {
  color: var(--accent, #3ddc97);
}
.status--low {
  color: #6cb2f7;
}
.status--high {
  color: #f0ad4e;
}
.status-bg--normal {
  background: var(--accent, #3ddc97);
}
.status-bg--low {
  background: #6cb2f7;
}
.status-bg--high {
  background: #f0ad4e;
}

/* ---------------- 全程指标 ---------------- */
.gbar {
  display: flex;
  padding: 20rpx 8rpx;
  border-radius: 14rpx;
  background: var(--card, #18222c);
}
.gitem {
  flex: 1;
  text-align: center;
  padding: 0 8rpx;
}
.gitem__num {
  font-size: 36rpx;
  font-weight: 700;
}
.gitem__unit {
  font-size: 20rpx;
  margin-left: 2rpx;
}
.gitem__name {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text, #eaf0f6);
}
.gitem__ref {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: var(--text-dim, #6b7686);
}

/* ---------------- 视频信息 ---------------- */
.meta {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 20rpx;
  border-radius: 14rpx;
  background: var(--card, #18222c);
}
.meta__i {
  width: 50%;
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
}
.meta__i:nth-child(odd) {
  padding-right: 24rpx;
  box-sizing: border-box;
}
.meta__k {
  font-size: 22rpx;
  color: var(--text-dim, #6b7686);
}
.meta__v {
  font-size: 22rpx;
}

/* ---------------- 底部 ---------------- */
.disclaimer {
  margin: 24rpx 24rpx 0;
  font-size: 20rpx;
  line-height: 32rpx;
  color: var(--text-dim, #6b7686);
}
.footer {
  margin: 24rpx 24rpx 0;
}
.btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
}
.btn--primary {
  color: #0f1720;
  font-weight: 600;
  background: var(--accent, #3ddc97);
}

/* ---------------- 空状态 ---------------- */
.empty {
  padding: 240rpx 60rpx 0;
  text-align: center;
}
.empty__icon {
  font-size: 80rpx;
  color: var(--text-dim, #6b7686);
}
.empty__text {
  margin: 20rpx 0 40rpx;
  font-size: 26rpx;
  color: var(--text-dim, #6b7686);
}

/* ================= v2 新增 ================= */

/* ---------------- 顶部机位标签 ---------------- */
.topbar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 8rpx 4rpx 4rpx;
}
.topbar__view {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent, #3ddc97);
}
.topbar__sub {
  font-size: 20rpx;
  color: var(--text-dim, #6b7686);
}

/* ---------------- 五态 critical 配色（v2） ---------------- */
.chip--critical_low,
.chip--critical_high {
  color: #ffffff;
  background: #ef4444;
}
.status--critical_low,
.status--critical_high {
  color: #ef4444;
}
.status-bg--critical_low,
.status-bg--critical_high {
  background: #ef4444;
}

/* ---------------- 指标卡术语解释行（v2） ---------------- */
.mcard__desc {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(255, 255, 255, 0.08);
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--text-dim, #6b7686);
}

/* ---------------- 指标空状态（用户决策 2） ---------------- */
.empty-metric {
  padding: 56rpx 20rpx;
  border-radius: 14rpx;
  background: var(--card, #18222c);
  text-align: center;
}
.empty-metric__icon {
  font-size: 56rpx;
}
.empty-metric__text {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text, #eaf0f6);
}
.empty-metric__sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-dim, #6b7686);
}

/* ---------------- 风险区（v2 区域4） ---------------- */
.risk-ok {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-radius: 14rpx;
  background: var(--card, #18222c);
  border: 1rpx solid rgba(61, 220, 151, 0.3);
}
.risk-ok__icon {
  font-size: 34rpx;
  margin-right: 14rpx;
}
.risk-ok__text {
  font-size: 26rpx;
  color: var(--accent, #3ddc97);
}

.rcard {
  padding: 22rpx;
  margin-bottom: 16rpx;
  border-radius: 14rpx;
  background: var(--card, #18222c);
  border-left: 8rpx solid transparent;
}
.rcard--high {
  border-left-color: #ef4444;
}
.rcard--medium {
  border-left-color: #f59e0b;
}
.rcard--low {
  border-left-color: #3b82f6;
}
.rcard__head {
  display: flex;
  align-items: center;
}
.rcard__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}
.rcard--high .rcard__dot { background: #ef4444; }
.rcard--medium .rcard__dot { background: #f59e0b; }
.rcard--low .rcard__dot { background: #3b82f6; }
.rcard__name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
}
.rcard__level {
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.rcard--high .rcard__level { color: #ef4444; background: rgba(239, 68, 68, 0.14); }
.rcard--medium .rcard__level { color: #f59e0b; background: rgba(245, 158, 11, 0.14); }
.rcard--low .rcard__level { color: #3b82f6; background: rgba(59, 130, 246, 0.14); }
.rcard__reason {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--text, #eaf0f6);
}
.rcard__suggest {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.04);
}
.rcard__suggest-title {
  font-size: 22rpx;
  color: var(--text-dim, #6b7686);
}
.rcard__suggest-item {
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--text, #eaf0f6);
}
.rcard__manual {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #48a7f5;
}

/* ---------------- 手册原文半屏弹窗 ---------------- */
.mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
}
.manual {
  width: 100%;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  background: #18222c;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 28rpx 40rpx;
  box-sizing: border-box;
}
.manual__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.manual__title {
  font-size: 30rpx;
  font-weight: 600;
}
.manual__close {
  font-size: 30rpx;
  color: var(--text-dim, #6b7686);
  padding: 8rpx 12rpx;
}
.manual__page {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #48a7f5;
}
.manual__body {
  margin-top: 18rpx;
  max-height: 40vh;
}
.manual__text {
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--text, #eaf0f6);
}
.manual__foot {
  margin-top: 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  color: #0f1720;
  font-weight: 600;
  background: var(--accent, #3ddc97);
}

/* ---------------- [查看完整报告] 占位（P1） ---------------- */
.report-btn {
  margin: 24rpx 24rpx 0;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: var(--text-dim, #6b7686);
  background: #18222c;
  border: 1rpx dashed #2a323e;
}

/* ================= v3 整页保存 ================= */
.op--primary {
  color: #0f1720;
  font-weight: 600;
  background: var(--accent, #3ddc97);
  border: 1rpx solid var(--accent, #3ddc97);
}
.op--savepage {
  flex: none;
  margin-right: 0;
  margin-top: 16rpx;
}
.op--loading {
  opacity: 0.72;
}
/* 离屏画布：不占布局、不影响交互 */
.snapshot-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
}
