<view class="page">

  <!-- 标题 -->
  <view class="hero">
    <view class="hero-title">⛳ 挥杆分析</view>
    <view class="hero-sub">拍一段挥杆，30 秒拿到 8 阶段姿态报告</view>
  </view>

  <!-- 机位三选一（2026-09-04：新增 auto） -->
  <view class="card view-card">
    <view class="card-title">选择拍摄机位</view>
    <view class="view-grid">
      <view
        class="view-option {{cameraView === 'auto' ? 'view-option--on' : ''}}"
        data-view="auto"
        bindtap="onSelectView">
        <view class="view-emoji">{{views.auto.icon}}</view>
        <view class="view-label">自动判定</view>
        <view class="view-sub">推荐</view>
        <view class="view-dot" wx:if="{{cameraView === 'auto'}}">✓</view>
      </view>
      <view
        class="view-option {{cameraView === 'face_on' ? 'view-option--on' : ''}}"
        data-view="face_on"
        bindtap="onSelectView">
        <view class="view-emoji">{{views.face_on.icon}}</view>
        <view class="view-label">正面机位</view>
        <view class="view-sub">face-on</view>
        <view class="view-dot" wx:if="{{cameraView === 'face_on'}}">✓</view>
      </view>
      <view
        class="view-option {{cameraView === 'down_the_line' ? 'view-option--on' : ''}}"
        data-view="down_the_line"
        bindtap="onSelectView">
        <view class="view-emoji">{{views.down_the_line.icon}}</view>
        <view class="view-label">侧面机位</view>
        <view class="view-sub">down-the-line</view>
        <view class="view-dot" wx:if="{{cameraView === 'down_the_line'}}">✓</view>
      </view>
    </view>
  </view>

  <!-- 机位示意图（纯 CSS 绘制，不引入图片资源） -->
  <view class="diagram card">
    <view class="diagram-row">
      <view class="phone {{cameraView === 'down_the_line' ? 'phone--landscape' : ''}}">
        <view class="phone-screen"></view>
      </view>

      <view class="distance">
        <view class="dist-line"></view>
        <view class="dist-text">2~3 m</view>
      </view>

      <view class="golfer">
        <view class="golfer-placeholder">{{views[cameraView].icon}}</view>
      </view>
    </view>
    <view class="diagram-caption">
      <block wx:if="{{cameraView === 'auto'}}">✨ 自动判定 · 系统根据画面识别机位</block>
      <block wx:elif="{{cameraView === 'face_on'}}">正面机位（face-on）· 手机竖持固定 · 全身入镜</block>
      <block wx:else>侧面机位（down-the-line）· 手机竖持固定 · 全身+球杆入镜</block>
    </view>
  </view>

  <!-- 拍摄要求（随机位切换） -->
  <view class="card req-card">
    <view class="card-title">拍摄要求 <text class="req-tag">{{viewLabel[cameraView]}}</text></view>
    <view class="req-item" wx:for="{{requirements}}" wx:key="*this">
      <view class="req-dot"></view>
      <view class="req-text">{{item}}</view>
    </view>
    <view class="req-note">当前版本仅支持<text class="req-strong">右手球手</text>；机位判定由后端按 9/9 实测准确度完成</view>
  </view>

  <!-- 选择视频 -->
  <view class="choose-row">
    <view class="choose-btn" bindtap="onShoot">
      <view class="choose-icon">📹</view>
      <view class="choose-text">拍摄</view>
    </view>
    <view class="choose-btn" bindtap="onAlbum">
      <view class="choose-icon">🖼</view>
      <view class="choose-text">从相册</view>
    </view>
  </view>

  <!-- 已选文件卡片 -->
  <view class="card file-card {{valid ? 'file-ok' : 'file-bad'}}" wx:if="{{video}}">
    <view class="file-row">
      <view class="file-name">已选：{{video.name}}</view>
      <view class="file-flag">{{valid ? '✓' : '✗'}}</view>
    </view>
    <view class="file-meta">时长 {{video.durationText}} · {{video.sizeText}}</view>
    <view class="file-error" wx:if="{{!valid}}">{{errorText}}</view>
  </view>

  <!-- 上传进度 -->
  <view class="card upload-card" wx:if="{{uploading}}">
    <view class="upload-text">正在上传 {{uploadPercent}}%</view>
    <view class="bar">
      <view class="bar-fill" style="width:{{uploadPercent}}%"></view>
    </view>
  </view>

  <!-- 开始分析 -->
  <button
    class="btn btn-primary submit"
    disabled="{{!canSubmit}}"
    bindtap="onSubmit">{{uploading ? '上传中...' : '开始分析'}}</button>
</view>
